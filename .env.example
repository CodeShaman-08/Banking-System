# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/banking-system

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,https://codeshaman-08.github.io

# Demo only: credit every new account with test funds so transfers can be tried
DEMO_FUNDING=true
